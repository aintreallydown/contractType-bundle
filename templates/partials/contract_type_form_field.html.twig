{% if field_value(form.position) == 1 %}

    <zb-select
        class="prevent-selected-order display-top"
        name="{{ field_name(form.contract) }}"
        value="{{ field_value(form.contract) }}"
        placeholder="{{ 'bundle.contract_type.form.placeholder'|trans({}, 'contractTypeBundle') }}"
        options="{{ form.vars.choices}}"
        required
    ></zb-select>

{% endif %}